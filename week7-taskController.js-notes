const {taskSchema, patchTaskSchema} = require("../validation/taskSchema")
const prisma = require("../db/prisma")

async function create(req, res) {

    const {error, value} = taskSchema.validate(req.body)
    if(error) {
        return res.status(400).json({
            message:"Validation failed",
            details: error.details
        })
    }
  
    const task = await prisma.task.create({
        data:{title: value.title, isCompleted: value.isCompleted ?? false, userId: global.user_id, priority: value.priority || "medium"},
        select: {id: true, title: true, isCompleted: true, priority:true}
    })
    return res.status(201).json(task)
}

async function index(req, res){
// Parse pagination parameters
const page = req.query.page !== undefined ? parseInt(req.query.page) : 1;//GET /api/tasks?page=2&limit=5 ?page=2(.page)
const limit = req.query.limit !== undefined ?parseInt(req.query.limit) : 10;//GET /api/tasks?page=2&limit=5 &limit=5(.limit)

//                              req.params	                                        req.query
// Comes from	                Route path placeholders (:id)	                    ?key=value after the URL
// Example route	            GET /api/tasks/:id	                                GET /api/tasks
// Example request	            GET /api/tasks/42	                                GET /api/tasks?page=2&limit=5
// Example code	                req.params.id → "42"	                            req.query.page → "2"
// Route definition needs it?	Yes — must define :id in the route	                No — works automatically, no special route setup needed

const skip = (page-1) * limit
// If requesting Page 1: (1 - 1) * 10 = 0 (skip 0 items, start at row 1).
// If requesting Page 2: (2 - 1) * 10 = 10 (skip first 10 items, start at row 11).


// validation for pagination
if (page < 1){
    return res. status(400).json({
        message: "Page must be >= 1"
    })
}

if (limit < 1 || limit > 100){
    return res.status(400).json({
        message: "Limit must be between 1 and 100"
    })
}

  const whereClause = {userId: global.user_id}

    if (req.query.find) {
        whereClause.title = {
            contains: req.query.find,
            mode: 'insensitive' //find uppercase & lowercase
        }
    }
// ex: contains
// GET /api/tasks?find=meeting
// req.query.find evaluates to the string "meeting".
// Prisma takes "meeting" and wraps it with wildcards (%meeting%).
// It checks the title column of every row belonging to that user in PostgreSQL to see if "meeting" appears anywhere inside it.

const tasks = await prisma.task.findMany({
        where: whereClause,
        select: {
            id:true, 
            title:true, 
            isCompleted:true, 
            priority: true, 
            createdAt: true, 
            User: {
                select: {
                    name:true,
                    email: true
            }}
        },
        skip: skip,
        take: limit,//— tells Prisma "only give me this many rows," which is what actually limits the result set size per page.
        orderBy: {createdAt: 'desc'}
    })
    // Get total count for pagination metadata
    const totalTasks = await prisma.task.count({//a completely separate query, counting all matching tasks for this user (ignoring skip/take) — needed to calculate how many total pages exist.
        where: whereClause
    })

    const pagination = {
        page: page,
        limit: limit,
        total: totalTasks,
        pages: Math.ceil(totalTasks / limit),//if you have 48 total tasks and show 10 per page, that's 48 / 10 = 4.8, rounded up to 5 pages (since the last page holds the leftover 8 tasks).
        hasNext: totalTasks > page * limit,//if you're on page 1 (limit=10), 1 * 10 = 10; if totalTasks is 48, 10 < 48 is true — there's more to see. On the last page (page 5), 5 * 10 = 50, and 50 < 48 is false — no more pages after this.
        hasPrev: page > 1//page here is just a plain number — specifically, whatever number came from req.query.page (or defaulted to 1). It's not "page1" as some special label — it's literally the integer value, like 1, 2, 3, 4, 5.
        // Walking through your exact examples:
            // If page is 5 → 5 > 1 → true → yes, there's a previous page (pages 1-4 exist before it)
            // If page is 4 → 4 > 1 → true → yes, there's a previous page
            // If page is 1 → 1 > 1 → false → no, this is the first page, there's nothing before it
    }

    //"page" is created by combining skip and take together, not something that exists independently.
    // take: limit by itself just means: "stop after collecting this many rows" — like saying "give me 10 items total, then stop."
    // But take alone isn't enough to create pages — if you only used take: 10 with no skip, you'd always get the same first 10 tasks, every single time, no matter what page number was requested. skip is what actually moves you to a different starting point — it's the combination of both together that creates the "paging" effect:

    // Page 1: skip: 0, take: 10 → tasks 1-10
    // Page 2: skip: 10, take: 10 → tasks 11-20
    // Page 3: skip: 20, take: 10 → tasks 21-30

    // So take: limit isn't "take 10 from that page" — it's more accurate to say skip decides where to start, and take decides how many to grab from there. Together, they carve the full list of tasks into consistent-sized chunks.


    //  if (tasks.length === 0) {
    //     return res.status(404).json({message: "No tasks found"})
    // }


    return res.status(200).json({tasks, pagination})
}

async function show (req, res, next) {
    const taskId = parseInt(req.params.id, 10)
    if(isNaN(taskId)){
        return res.status(400).json({message: "ID is not valid"})
    }

    let task
try{
    task = await prisma.task.findUnique({
        where:{
            id_userId:
                {
                    id: taskId, 
                    userId: global.user_id
                }
            },
        select:{
            id: true, 
            title: true, 
            isCompleted: true,
            priority: true,
            User:{
                select:{
                    name: true,
                    email: true
                }
            }
        }
    })
    }catch(err){
    if(err.code === "P2025") {
        return res.status(404).json({message: "The task was not found."})
    }else{
        return next(err)
    }}

     if (!task) {
        return res.status(404).json({message: "The task was not found."})
    }

    return res.status(200).json(task)
    }

    async function update(req, res, next) {

        const {error, value} = patchTaskSchema.validate(req.body)
        if(error){
            return res.status(400).json({
                message: "Validation failed",
                details: error.details
            })
        }
        const taskId = parseInt(req.params.id, 10)
        if(isNaN(taskId)) {
            return res.status(400).json({message: "ID is not valid"})
        }
      
        let updatedTask
        try{
            updatedTask = await prisma.task.update({
                data: value,
                where: {
                    id_userId:
                        {
                            id: taskId, 
                            userId: global.user_id
                        }
            },
                select: {id: true, title: true, isCompleted: true, priority: true}
            }  
        )}
        catch(err)
        {   //P2025 — record not found → 404
            if(err.code === "P2025"){
            return res.status(404).json({message: "The task was not found."})
        }else{
        return next(err)
    }
}
       return res.status(200).json(updatedTask)
}
async function deleteTask(req, res, next) {

const taskId = parseInt(req.params.id, 10)
if(isNaN(taskId)){
    return res.status(400).json({
        message: "ID is not valid"
    })
}

try{
    await prisma.task.delete(
    {
        where: {
            id_userId:
                {
                id: taskId, 
                userId: global.user_id
                }
         }
    }
)
}
catch(err){
if(err.code === "P2025"){
    return res.status(404).json({message: "The task was not found."})
}else{
    return next(err)
}}
return res.status(200).json({message: "Task deleted successfully"})
}


// ========What is Bulk Creation?=======send all many tasks at one=========
// Bulk creation (also called batch creation or batch insertion) means sending multiple records to the database in a single database request, rather than inserting them one by one in separate loop iterations.
// Example:
// Instead of running 3 separate queries:

// INSERT INTO tasks ...
// INSERT INTO tasks ...
// INSERT INTO tasks ...

// Bulk creation sends all 3 tasks in one single SQL command:

// SQL
// INSERT INTO tasks (title, duration) VALUES 
// ('5 mins run', 5),
// ('10 mins run', 10),
// ('15 mins run', 15);


// POST /api/tasks/bulk
exports.bulkCreate = async(req, res, next) => {
    const {tasks} = req.body 
// req.body is the JSON data sent over the internet by the client (like a React app, Postman, or fetch request).
// When you write const { tasks } = req.body;, JavaScript looks for a JSON key named "tasks" inside the incoming HTTP request payload.
    
// The Client/User Input:
// The user types some data into an input field or selects options. The client code packages that user input under the key "tasks" and sends it over HTTP:
// {
//   "tasks": [ "Buy milk", "Clean room" ]
// }

// 1. Validate that tasks is a non-empty array
if(!tasks || !Array.isArray(tasks) || tasks.length === 0) {

// Array.isArray() is a built-in JavaScript function that checks whether a variable is an array.
// It returns:
// true if the value passed to it is an array (e.g., [1, 2, 3] or []).
// false if it is anything else (e.g., a string "hello", a number 42, an object {} or null/undefined).

// Quick Examples
// JavaScript
// Array.isArray([1, 2, 3]); // true
// Array.isArray([]);         // true

// Array.isArray("tasks");    // false
// Array.isArray({ id: 1 });  // false
// Array.isArray(null);       // false

            return res.status(400).json({
                error: "Invalid request data. Expected an array of tasks. "
            })
    }

      // Validate all tasks before insertion
      const validTasks = []
      for(const task of tasks) {
        const {error, value} = taskSchema.validate(task) 
        if(error){
            return res.status(400).json({
                error: "Validation failed",
                details: error.details
            })
        }
        // 2. Attach the logged-in user's ID to every task object
        validTasks.push({
            title: value.title,
            isCompleted: value.isCompleted || false,
            priority: value.priority || 'medium',
            userId: global.user_id
        })
      }
        // Use createMany for batch insertion
        // 3. Bulk insert into PostgreSQL at once!
      try{
        const result = await prisma.task.createMany({
            data: validTasks, //data is containing the array of tasks
            skipDuplicates: false//"Do NOT skip duplicates. If any item is a duplicate or violates a unique rule, stop immediately, fail the whole operation, and throw an error."
        //fail and throw an error if there is a duplicate
        })
        // 4. Send back a single success response
        res.status(201).json({
            message: "success!",
            tasksCreated: result.count,//.count => result is an object, so we access the count property //result = {count: 5} => result.count = 5
            totalRequested: validTasks.length//.length => validTasks is an Array, so how many items are in the array //const validTasks = [{ title: "Task 1" }, { title: "Task 2" }]; length = 2
        })
      }catch(err){
        return next(err)
      }


}



module.exports = {index, show, update, deleteTask, create, bulkCreate: exports.bulkCreate}